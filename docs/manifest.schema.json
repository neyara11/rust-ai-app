{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eco-aiops.local/manifest.schema.json",
  "title": "ECO AIOps mini-app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "name",
    "version",
    "publisher",
    "profile",
    "tools",
    "connections",
    "capabilities",
    "hashes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "app_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "min_shell_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publisher": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "icon": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.[sS][vV][gG]$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_prompt"],
      "properties": {
        "system_prompt": {
          "type": "string",
          "minLength": 1
        },
        "model_hint": {
          "type": "string"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool"],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "bin": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "io": {
            "enum": ["files", "json"]
          },
          "parameters": {
            "type": "object"
          },
          "secrets": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout_secs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "stream": {
            "enum": ["read", "write"]
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "type": {
            "enum": ["llm", "http-mcp"]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_scopes": {
          "type": "array",
          "items": {
            "enum": ["workspace"]
          }
        },
        "external_writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quota_mb": {
          "type": "integer",
          "minimum": 1
        },
        "ttl_hours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
