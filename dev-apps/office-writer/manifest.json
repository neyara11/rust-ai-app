    "bin/office-kit.exe": "sha256:d5774b5b490ec251b464cbed63a43d0ba246b205628d86de92924f45c1ecb39b",
    "bin/diagram-render.exe": "sha256:acdda725c4e96b1452f8df160935e7eee3d1fd8b92d3230d397e6c5afb20461a",
    "icon.svg": "sha256:fb5468ae7d2943d7e4260e3c2109050ad58cf1c509cb760533047dffd53076d4",
