{
  "schema_version": 2,
  "app_id": "office-writer",
  "name": "Документы, таблицы и схемы",
  "version": "0.1.2",
  "min_shell_version": "0.4.0",
  "publisher": "CN=ECO AIOps Dev",
  "description": "Готовит Word и Excel, встраивает графики и схемы, читает готовые docx и xlsx.",
  "icon": "icon.svg",
  "profile": {
    "system_prompt": "prompt/system.md",
    "model_hint": "gateway-default",
    "max_steps": 32
  },
  "tools": [
    {
      "tool": "read_office",
      "bin": "bin/office-kit.exe",
      "argv": ["read", "--input", "{input}", "--output", "{output}"],
      "stream": "read",
      "timeout_secs": 120
    },
    {
      "tool": "docx_export",
      "bin": "bin/office-kit.exe",
      "argv": ["docx", "--input", "{input}", "--output", "{output}"],
      "stream": "write",
      "timeout_secs": 120
    },
    {
      "tool": "xlsx_export",
      "bin": "bin/office-kit.exe",
      "argv": ["xlsx", "--input", "{input}", "--output", "{output}"],
      "stream": "write",
      "timeout_secs": 120
    },
    {
      "tool": "render_mermaid",
      "bin": "bin/diagram-render.exe",
      "argv": ["mermaid", "--input", "{input}", "--output", "{output}"],
      "stream": "write",
      "timeout_secs": 60
    },
    {
      "tool": "render_chart",
      "bin": "bin/diagram-render.exe",
      "argv": ["chart", "--input", "{input}", "--output", "{output}"],
      "stream": "write",
      "timeout_secs": 60
    }
  ],
  "connections": [
    {
      "id": "llm",
      "type": "llm",
      "required": true
    }
  ],
  "capabilities": {
    "index_allowlist": [],
    "file_scopes": [
      "workspace"
    ],
    "external_writes": []
  },
  "artifacts": {
    "quota_mb": 50,
    "ttl_hours": 72
  },
  "hashes": {
    "prompt/system.md": "sha256:1490d21ec42b14e1f579aaac34a11d9e6c29ee41300d2be67a8ad7def12c85a6",
